{
  "name": "tutor-compass",
  "version": "0.1.0",
  "private": true,
  "description": "Tutor Compass: AI-assisted administrative decisions for small tutoring businesses (INFS3605 alpha)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:users": "node --env-file=.env.local scripts/seed-users.mjs",
    "smoke": "node --env-file=.env.local scripts/smoke-test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "sql:bundle": "node scripts/bundle-sql.mjs",
    "catalogue:generate": "tsx scripts/generate-catalogue.ts",
    "demo:generate": "node scripts/build-demo-dataset.mjs",
    "i18n:index": "node scripts/locale-index.mjs",
    "i18n:check": "vitest run tests/i18n.test.ts",
    "i18n:build": "node scripts/locale-build.mjs",
    "retention:generate": "tsx scripts/build-retention-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@supabase/supabase-js": "^2.117.3",
    "i18next": "26.4.2",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-i18next": "17.0.16",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
